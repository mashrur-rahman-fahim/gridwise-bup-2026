# Copy to .env and fill in. NEVER commit the filled version.
# Names only are documented in README; values must never be committed.

# Required: Google Gemini API key used for operator-note interpretation.
GEMINI_API_KEY=

# Optional: model id. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: port the service binds. Defaults to 8000.
PORT=8000
